# Application Environment (development | production)
APP_ENV=development
ENVIRONMENT=development

# Database Configuration (PostgreSQL with automatic SQLite fallback)
POSTGRES_USER=kyc_user
POSTGRES_PASSWORD=kyc_password_placeholder
POSTGRES_DB=kyc_db
DATABASE_URL=sqlite:///./kyc.db

# Backend (FastAPI + SQLAlchemy)
BACKEND_PORT=8000
PORT=8000
FERNET_KEY=placeholder_base64_32bytes_fernet_key_here=
SECRET_KEY=session_signing_secret_key_placeholder
IDENTIFIER_HMAC_KEY=hmac_salt_secret_key_placeholder
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=3145728

# Administrator Bootstrap
ADMIN_EMAIL=admin@kyc-verification.internal
ADMIN_NAME=Lead Compliance Administrator
ADMIN_PASSWORD=change_this_admin_password_123!

# Session & Retention Governance (DPDP Act)
SESSION_EXPIRY_MINUTES=60
RETENTION_DAYS=30

# ML Analysis Service (inprocess for Render deploy / http for microservice)
ML_MODE=inprocess
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=shared_internal_secret_key_placeholder
X_INTERNAL_KEY=shared_internal_secret_key_placeholder
BLUR_THRESHOLD=100

# Storage Backend (db = PostgreSQL byte blobs | disk = filesystem)
STORAGE_BACKEND=db

# Demo Mode Flags (Set to false for production pilot)
DEMO_MODE=true
SEED_ON_START=true
DEMO_ADMIN_KEY=demo_admin_secret_key_placeholder

# Frontend (if running separate Vite dev server)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
