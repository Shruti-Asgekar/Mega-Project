# ==============================================================================
# Root Environment Variables Template (.env.example)
# Copy to .env for local development with docker-compose
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=kyc_user
POSTGRES_PASSWORD=kyc_password_placeholder
POSTGRES_DB=kyc_db
DATABASE_URL=postgresql://kyc_user:kyc_password_placeholder@localhost:5432/kyc_db?schema=public

# Express Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_min_32_characters_placeholder
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_placeholder
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=shared_internal_secret_key_placeholder
UPLOAD_DIR=./uploads

# Flask ML Service
ML_PORT=8000
FLASK_ENV=development
X_INTERNAL_KEY=shared_internal_secret_key_placeholder

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
